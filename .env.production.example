# ==============================================================================
# SGMS — Variáveis de Ambiente de Produção On-Premise (Docker Compose)
# Copie este arquivo para .env na raiz do projeto antes de subir os containers:
# cp .env.production.example .env
# ==============================================================================

# Credenciais do Banco de Dados PostgreSQL 16 (Obrigatórias — Zero Fallback)
POSTGRES_USER=sgms_admin
POSTGRES_PASSWORD=ALTERE_ESTA_SENHA_FORTE_PRODUCAO_2026
POSTGRES_DB=sgms_db

# Segurança JWT Backend (Obrigatória — Gere uma chave aleatória forte para produção)
JWT_SECRET=ALTERE_ESTA_CHAVE_JWT_SECRETA_MINIMO_32_CARACTERES_2026
JWT_EXPIRES_IN=12h

# Porta HTTP exposta na Rede Local LAN pelo Nginx (Padrão: 80 -> http://sgms.local)
HTTP_PORT=80

# Fuso Horário Operacional da Planta Fabril
TZ=America/Sao_Paulo

